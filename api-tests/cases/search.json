{
  "description": "Front-end Search API checks (GET /search, GET /books/{book_id}, GET /search/filters, GET /health and CORS) against the fixture datamart of api-tests/src/main/resources/fixture-datamart.sql. Expected results are worked out by hand from the six fixture books.",
  "cases": [
    {
      "name": "health: the service is up",
      "path": "/health",
      "status": 200,
      "body": {
        "service": "search-service",
        "status": "UP"
      }
    },
    {
      "name": "keyword: one term, ordered by score then book_id, default page",
      "path": "/search?q=adventure",
      "status": 200,
      "body": {
        "query": "adventure",
        "terms": [
          "adventure"
        ],
        "filters": {},
        "total": 5,
        "offset": 0,
        "limit": 20,
        "results": [
          {
            "book_id": 2,
            "title": "Tales of Adventure",
            "author": "Mark Twain",
            "language": "en",
            "year": 2004,
            "score": 4
          },
          {
            "book_id": 4,
            "score": 4
          },
          {
            "book_id": 1,
            "score": 2
          },
          {
            "book_id": 3,
            "score": 2
          },
          {
            "book_id": 5,
            "score": 1
          }
        ]
      }
    },
    {
      "name": "keyword: several terms are combined with AND and their frequencies summed",
      "path": "/search?q=river%20adventure",
      "status": 200,
      "body": {
        "terms": [
          "river",
          "adventure"
        ],
        "total": 3,
        "results": [
          {
            "book_id": 5,
            "score": 10
          },
          {
            "book_id": 1,
            "score": 7
          },
          {
            "book_id": 2,
            "score": 5
          }
        ]
      }
    },
    {
      "name": "keyword: case, punctuation and repeated words are normalised",
      "path": "/search?q=RIVER,%20Adventure!%20river",
      "status": 200,
      "body": {
        "query": "RIVER, Adventure! river",
        "terms": [
          "river",
          "adventure"
        ],
        "total": 3,
        "results": [
          {
            "book_id": 5
          },
          {
            "book_id": 1
          },
          {
            "book_id": 2
          }
        ]
      }
    },
    {
      "name": "keyword: accented words match whole",
      "path": "/search?q=Rivi%C3%A8re",
      "status": 200,
      "body": {
        "terms": [
          "rivière"
        ],
        "total": 1,
        "results": [
          {
            "book_id": 4,
            "title": "Voyage sur la rivière",
            "author": null,
            "language": "fr",
            "year": 1998,
            "score": 2
          }
        ]
      }
    },
    {
      "name": "keyword: missing metadata is returned as null",
      "path": "/search?q=moor",
      "status": 200,
      "body": {
        "total": 2,
        "results": [
          {
            "book_id": 3,
            "author": "Charlotte Brontë",
            "score": 7
          },
          {
            "book_id": 6,
            "title": "Untitled",
            "author": "Anonymous",
            "language": null,
            "year": 2010,
            "score": 1
          }
        ]
      }
    },
    {
      "name": "filter author: case-insensitive substring",
      "path": "/search?q=adventure&author=TWAIN",
      "status": 200,
      "body": {
        "filters": {
          "author": "TWAIN"
        },
        "total": 2,
        "results": [
          {
            "book_id": 2
          },
          {
            "book_id": 1
          }
        ]
      }
    },
    {
      "name": "filter author: non-ASCII letters are case-folded",
      "path": "/search?q=moor&author=BRONT%C3%8B",
      "status": 200,
      "body": {
        "filters": {
          "author": "BRONTË"
        },
        "total": 1,
        "results": [
          {
            "book_id": 3
          }
        ]
      }
    },
    {
      "name": "filter author: books without author never match",
      "path": "/search?q=rivi%C3%A8re&author=a",
      "status": 200,
      "body": {
        "total": 0,
        "results": []
      }
    },
    {
      "name": "filter language: exact code, normalised to lower case",
      "path": "/search?q=adventure&language=FR",
      "status": 200,
      "body": {
        "filters": {
          "language": "fr"
