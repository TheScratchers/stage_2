<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.thescratchers</groupId>
        <artifactId>stage2-parent</artifactId>
        <version>1.0.0</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>integration-bench</artifactId>
    <packaging>jar</packaging>
    <name>Search Engine - integration-bench</name>
    <description>Integration benchmarks of the whole system: search latency, replicas, indexing throughput,
        coordination cost and resource usage.</description>

    <properties>
        <main.class>com.thescratchers.searchengine.benchmarks.integration.IntegrationBenchmark</main.class>
    </properties>

    <dependencies>
        <!-- Pipeline and LocalGutenberg start the system; the load client generates the search load. -->
        <dependency>
            <groupId>com.thescratchers</groupId>
            <artifactId>api-tests</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.thescratchers</groupId>
            <artifactId>load-client</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.thescratchers</groupId>
            <artifactId>common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.activemq</groupId>
            <artifactId>activemq-client</artifactId>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
